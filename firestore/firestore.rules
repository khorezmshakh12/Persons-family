rules_version = '2';

// Firestore here is a thin realtime layer on top of Cloud SQL (the source
// of truth for everything except live chat delivery) — see
// src/lib/firebase/README.md for the full design. Nothing but Server
// Actions (via the Admin SDK, which bypasses these rules entirely) ever
// writes to board_signals, nav_badge_signals, announcements_signal, or
// chats/*/messages — so those collections only need read rules. presence/*
// is the one collection the browser writes to directly (a heartbeat), since
// only the client itself knows when its own tab is still open.
//
// request.auth.uid here is NOT the app's real session — it's a parallel
// Firebase Auth session established via a custom token minted from the
// session cookie (see lib/actions/realtime-token.ts + lib/firebase/client.ts)
// specifically so these rules have something to check. The uid values match
// 1:1 with Cloud SQL's profiles.id / Identity Platform uid.
service cloud.firestore {
  match /databases/{database}/documents {

    // Board "something changed" signals (tasks, issues) — every signed-in
    // staff member can see the boards, so any signed-in read is fine; the
    // real authorization already happened server-side when the client
    // re-fetches via the board's Server Action after the signal fires.
    match /board_signals/{board} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-user nav badge signal — only that user needs to know their own
    // counts changed.
    match /nav_badge_signals/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /announcements_signal/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Chat conversations, keyed by the two participants' sorted uids
    // joined with "_" (mirrors dm_conversations' sorted-pair convention in
    // Cloud SQL). Only a participant may read the thread or its messages;
    // the parent doc's `participants` array is what messages/{id} checks
    // against via get(), since message docs don't carry it themselves.
    match /chats/{conversationId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(conversationId)).data.participants;
        allow write: if false;
      }
    }

    // Group (teacher/TA) chat — a separate, smaller chat system from the DM
    // one above (staff_chat_messages in Cloud SQL, keyed by the group's own
    // id, always exactly the group's teacher + assigned TA). Firestore
    // rules can't query Cloud SQL, so group_chat_meta/{groupId} mirrors
    // just the membership (kept in sync by groups.ts's
    // syncGroupChatMembers/deleteGroupChatMeta) purely so this rule has
    // something to check.
    match /group_chat_meta/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    match /group_chats/{groupId} {
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/group_chat_meta/$(groupId)).data.members;
        allow write: if false;
      }
    }

    // Presence heartbeat — the one collection the browser writes directly,
    // since only the client's own live tab knows it's still open. Anyone
    // signed in can read anyone's presence (mirrors the old app showing
    // every staff member's online dot); a user may only touch their own doc.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
